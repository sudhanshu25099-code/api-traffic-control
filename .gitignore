# ─── Secrets (NEVER commit) ───────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ─── Python bytecode / caches ─────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ─── Virtual environments ─────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version

# ─── Test / coverage artifacts ────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ─── Locust ───────────────────────────────────────────────
locust_report.html
locust_*.csv
locust_*.log

# ─── IDE / editors ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS junk ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Docker (runtime, not config) ─────────────────────────
docker-compose.override.yml

# ─── Postgres (if you ever dump locally) ──────────────────
*.sql.gz
pgdata/
postgres-data/

# ─── Logs ─────────────────────────────────────────────────
*.log
logs/
