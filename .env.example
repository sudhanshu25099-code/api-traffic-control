# ─── PostgreSQL ──────────────────────────────────────────
# Used by app/database.py (asyncpg driver).
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/traffic

# Pool tuning (see README "Design Decisions" for sizing math)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ─── Redis ───────────────────────────────────────────────
# redis://[:password@]host:port/db_number
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5

# ─── Application ─────────────────────────────────────────
APP_NAME=API Traffic Control
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# ─── Rate limiter defaults ───────────────────────────────
# Used only when no rule is found for a key (should be rare).
DEFAULT_CAPACITY=100
DEFAULT_REFILL_RATE=1.67       # tokens per second (≈100/min)
DEFAULT_WINDOW_SECONDS=60
DEFAULT_ALGORITHM=token_bucket # one of: fixed_window | token_bucket